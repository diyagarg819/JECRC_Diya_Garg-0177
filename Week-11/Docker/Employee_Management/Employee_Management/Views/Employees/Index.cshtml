@model IEnumerable<Employee_Management.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-6 fw-bold mb-1">
            <i class="bi bi-people-fill text-primary me-2"></i>Employee Directory
        </h1>
        <p class="text-muted mb-0">Manage your organization's workforce</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
        <i class="bi bi-plus-circle me-2"></i>Add Employee
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body py-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                           class="form-control border-start-0 ps-0"
                           placeholder="Search by name or department..." />
                </div>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary px-4">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Clear</a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox display-4 text-muted"></i>
                <p class="text-muted mt-3 fs-5">No employees found.</p>
                <a asp-action="Create" class="btn btn-primary mt-2">Add your first employee</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>
                                <a asp-action="Index"
                                       asp-route-sortOrder="@ViewData["NameSort"]"
                                       asp-route-searchString="@ViewData["CurrentFilter"]"
                                       class="text-white text-decoration-none">
                                    Name <i class="bi bi-arrow-down-up ms-1 opacity-75"></i>
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index"
                                       asp-route-sortOrder="@ViewData["DeptSort"]"
                                       asp-route-searchString="@ViewData["CurrentFilter"]"
                                       class="text-white text-decoration-none">
                                    Department <i class="bi bi-arrow-down-up ms-1 opacity-75"></i>
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index"
                                       asp-route-sortOrder="@ViewData["SalarySort"]"
                                       asp-route-searchString="@ViewData["CurrentFilter"]"
                                       class="text-white text-decoration-none">
                                    Salary <i class="bi bi-arrow-down-up ms-1 opacity-75"></i>
                                </a>
                            </th>
                            <th>Joined</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model)
                        {
                            <tr>
                                <td class="text-muted small">@emp.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle bg-primary text-white">
                                            @emp.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="fw-semibold">@emp.Name</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-info-subtle text-info-emphasis px-3 py-2">
                                        @emp.Department
                                    </span>
                                </td>
                                <td class="fw-semibold text-success">₹@emp.Salary.ToString("N0")</td>
                                <td class="text-muted small">@emp.CreatedDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Details" asp-route-id="@emp.Id"
                                               class="btn btn-sm btn-outline-info" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@emp.Id"
                                               class="btn btn-sm btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@emp.Id"
                                               class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-transparent text-muted small py-3 px-4">
                Showing <strong>@Model.Count()</strong> employee(s)
            </div>
        }
    </div>
</div>

<style>
    .avatar-circle {
        width: 36px; height: 36px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 0.9rem;
        flex-shrink: 0;
    }
    .bg-info-subtle { background-color: #cff4fc !important; }
    .text-info-emphasis { color: #055160 !important; }
</style>
